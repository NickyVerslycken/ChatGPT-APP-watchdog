<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tiny dependency-free checks for the session-file parsing. Run with: dotnet run, optionally followed by the path of a .codex folder -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ChatGptWatchdog.Core\ChatGptWatchdog.Core.csproj" />
  </ItemGroup>
</Project>
